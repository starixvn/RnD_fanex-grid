@{
    ViewBag.Title = "Format Number";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
}


<div id="sourcecontainer">
    <div id="gridId" class="freegrid  content-grid">
      var gridOptions =
        {
            columns: [
                { HeaderText: "Header 1", Width: 60, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "Header 2", Width: 70, Name: "Text1", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatNegative: '($)' },
                { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                { HeaderText: "Header 4", Width: 100, Name: "Number2", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0." },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.0" },
                { HeaderText: "Header 6", Width: 110, Name: "Text2" },
                { HeaderText: "Header 7", Width: 120, Name: "Text3" },
                { HeaderText: "Header 8", Width: 150, Name: "Text4" },
                { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00" },
                { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right", FormatNumber: "0,0.00", FormatPositive: '[$]' }
            ],
            bodyRows: generateData(100),
            gridExpandHeight: 150
        };
    $(function () {
        var currentGrid = $("#gridId").fanexGrid(gridOptions);
    });
    </div>
</div>
