@{
    ViewBag.Title = "Show/Hide Columns";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
}

<div id="sourcecontainer">
    <div id="filter-bar">
        <input type="button" value="Hide Column 1,2,4,8" id="hide1248" />
        <input type="button" value="Hide Column 3,4,5,6,10" id="hide345610"/>
        <input type="button" value="Hide Column 4,5,6,7" id="hide4567" />
        <input type="button" value="Show All" id="showall" />
    </div>
    <div id="gridId" class="freegrid  content-grid">
    </div>
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
    var footerRows = [
                  {
                      Columns: [
                        { Value: "Total", Name: "No" },
                        { Value: "Footer 1", Name: "Text1" },
                        { Value: "Footer 3", Name: "Number1" },
                        { Value: "Footer 4", Name: "Number2" },
                        { Value: "Footer 5", Name: "Number3" },
                        { Value: "Footer 2", Name: "Text2" },
                        { Value: "Footer 6", Name: "Text3" },
                        { Value: "Footer 8", Name: "Text4" },
                        { Value: "Footer 9", Name: "Number4" },
                        { Value: "Footer 10", Name: "Number5" }
                    ]
                  }
            ];
    var gridOptions =
        {
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                            ]
                     }
            ],
            columns: [
                { HeaderText: "Header 1", Width: 90, Name: "No", HeaderAlign: "center", CellAlign: "center" },
                { HeaderText: "Header 2", Width: 110, Name: "Text1", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 3", Width: 150, Name: "Number1", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 4", Width: 150, Name: "Number2", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 6", Width: 140, Name: "Text2" },
                { HeaderText: "Header 7", Width: 120, Name: "Text3" },
                { HeaderText: "Header 8", Width: 150, Name: "Text4" },
                { HeaderText: "Header 9", Width: 130, Name: "Number4", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 10", Width: 160, Name: "Number5", HeaderAlign: "center", CellAlign: "right" }
            ],
            bodyRows: generateData(500),
            hiddenColumns: [0, 1, 3, 7],
            gridExpandHeight: 150,
            enableHiddenColumns: false,
            numberOfFrozenColumn: 3,
            showFooter: true,
            footerRows: footerRows
        };
        $(function () {
            var currentGrid = $("#gridId").fanexGrid(gridOptions);

            $('#hide1248').click(function () {
                $("#gridId").fanexGrid("hideColumns", gridOptions, [0, 1, 3, 7]);
            })
            $('#hide345610').click(function () {
                $("#gridId").fanexGrid("hideColumns", gridOptions, [2, 3, 4, 5, 9]);
            });
            $('#hide4567').click(function () {
                $("#gridId").fanexGrid("hideColumns", gridOptions, [3, 4, 5, 6]);
            });
            $('#showall').click(function () {
                $("#gridId").fanexGrid("hideColumns", gridOptions, []);
            });
        });
    </pre>
</div>
