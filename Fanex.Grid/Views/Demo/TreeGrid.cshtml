@{
    ViewBag.Title = "Tree Grid";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
}

<div id="sourcecontainer">
    <div id="gridId" class="freegrid  content-grid">
    </div>
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
    var gridOptions =
        {
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                            ]
                     }
            ],
            columns: [
                { HeaderText: "Header 1", Width: 60, Name: "No", HeaderAlign: "center", CellAlign: "left"},
                { HeaderText: "Header 2", Width: 70, Name: "Text1", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right"},
                { HeaderText: "Header 4", Width: 100, Name: "Number2", HeaderAlign: "center", CellAlign: "right", ShowCollapseExpand: true },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 6", Width: 110, Name: "Text2" },
                { HeaderText: "Header 7", Width: 120, Name: "Text3" },
                { HeaderText: "Header 8", Width: 150, Name: "Text4" },
                { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right" }
            ],
            bodyRows: generateTreeData(10),
            gridExpandHeight: 170,
            showTree: true,
            showTitle: true,
            titleInfo:
                {
                    text: "Demo Title",
                    showCollapseExpandButton: true
                },
            showDistinctRow: false
        };
    $(function () {
        var currentGrid = $("#gridId").fanexGrid(gridOptions);
    });
    </pre>
</div>
<script type="text/javascript">
    var gridOptions =
        {
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                            ]
                     }
            ],
            columns: [
                { HeaderText: "Header 1", Width: 60, Name: "No", HeaderAlign: "center", CellAlign: "left"},
                { HeaderText: "Header 2", Width: 70, Name: "Text1", HeaderAlign: "center", CellAlign: "left" },
                { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right"},
                { HeaderText: "Header 4", Width: 100, Name: "Number2", HeaderAlign: "center", CellAlign: "right", ShowCollapseExpand: true },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 6", Width: 110, Name: "Text2" },
                { HeaderText: "Header 7", Width: 120, Name: "Text3" },
                { HeaderText: "Header 8", Width: 150, Name: "Text4" },
                { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right" }
            ],
            bodyRows: generateTreeData(10),
