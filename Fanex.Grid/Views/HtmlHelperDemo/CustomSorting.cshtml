@{
    ViewBag.Title = "Custom Sorting";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
    var gridViewModel = new GridViewModel(10, false, true);
}


<div id="sourcecontainer">
    @(Html.FanexGrid("grid-id")
        .AddColumn(new Column(gridViewModel.FirstColumnName, "First Column", 300).SetSortable("desc"))
        .AddColumn(new Column(gridViewModel.SecondColumnName, "Second Column", 300).SetSortable())
                .AddColumn(new Column(gridViewModel.ThirdColumnName, "Third Column", 300).SetSortable())
        .AddColumn(new Column(gridViewModel.FourthColumnName, "Fourth Column", 300).SetSortable())
                .AddColumn(new Column(gridViewModel.FifthColumnName, "Fifth Column", 300).SetSortable())
        .AddBodyRows(gridViewModel.BodyRows)
        .AddHeaderRows(gridViewModel.HeaderRows)
.SetSorting(new SortOption().SetCustomGridSortFunction("sort.customGridSort").OnBeforeGridSort("sort.beforeGridSorted").OnAfterGridSorted("sort.afterGridSorted"))
    )
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
        
    </pre>
</div>
<script type="text/javascript">
    var sort =
    {
        beforeGridSorted: function (rows, sortColumnName, sortDirection) {
            alert("Before sort: BodyRows length: " + rows.length + ', columnSort: ' + sortColumnName + ', direction: ' + sortDirection);
            return rows;
        },
        afterGridSorted: function (rows, sortColumnName, sortDirection) {
            alert("After Sort: BodyRows length: " + rows.length + ', columnSort: ' + sortColumnName + ', direction: ' + sortDirection);
            return rows;
        },
        customGridSort: function (rows, sortColumnName, sortDirection) {
            rows.pop();
            return rows;
        },
        serverSortFunction: null
