@{
    ViewBag.Title = "Custom Sorting";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
}


<div id="sourcecontainer">
    <div id="gridId" class="freegrid  content-grid">
    </div>
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
         var gridOptions =
        {
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                            ]
                     }
            ],
            columns: [
                { HeaderText: "Header 1", Width: 80, Name: "No", HeaderAlign: "center", CellAlign: "center", Sort: true },
                { HeaderText: "Header 2", Width: 80, Name: "Text1", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 4", Width: 100, Name: "Number2", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 6", Width: 110, Name: "Text2", Sort: true },
                { HeaderText: "Header 7", Width: 120, Name: "Text3", Sort: true },
                { HeaderText: "Header 8", Width: 150, Name: "Text4", Sort: true },
                { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right", Sort: true }
            ],
            bodyRows: generateData(10),
           gridExpandHeight: 150,
            numberOfFrozenColumn: 2,
            sortOption:
            {
                beforeGridSorted: function (rows, sortColumnName, sortDirection) {
                    alert("Before sort: BodyRows length: " + rows.length + ', columnSort: ' + sortColumnName + ', direction: ' + sortDirection);
                    return rows;
                },
                afterGridSorted: function (rows, sortColumnName, sortDirection) {
                    alert("After Sort: BodyRows length: " + rows.length + ', columnSort: ' + sortColumnName + ', direction: ' + sortDirection);
                    return rows;
                },
                customGridSort: function (rows, sortColumnName, sortDirection) {
                    rows.pop();
                    return rows;
                },
                serverSortFunction: null
                // Sort From Server
                //                function (sortColumnName, sortDirection) {
                //                    //console.log("1" + sortColumnName + ':' + sortDirection);
                //                    setTimeout(function () {
                //                        gridOptions.bodyRows.pop();
                //                        gridOptions.bodyRows.pop();
                //                        $("#gridId").fanexGrid('reRenderBodyAfterSort', gridOptions, sortColumnName, sortDirection);
                //                    }, 2000);
                //                }
            }
        };
    $(function () {
        var currentGrid = $("#gridId").fanexGrid(gridOptions);
    });
    </pre>
</div>
