@{
    ViewBag.Title = "Default Functionality";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
    var gridViewModel = new GridViewModel();
}

<div id="sourcecontainer">
    @(Html.FanexGrid("grid-id")
        .AddColumn(new Column(gridViewModel.FirstColumnName, "First Column", 300))
        .AddColumn(new Column(gridViewModel.SecondColumnName, "Second Column", 300))
        .AddColumn(new Column(gridViewModel.ThirdColumnName, "Third Column", 300))
        .AddColumn(new Column(gridViewModel.FourthColumnName, "Fourth Column", 300))
        .AddColumn(new Column(gridViewModel.FifthColumnName, "Fifth Column", 300))
        .AddBodyRows(gridViewModel.BodyRows)
    )
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">

    </pre>
</div>
