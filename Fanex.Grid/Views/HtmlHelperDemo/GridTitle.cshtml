@{
    ViewBag.Title = "Grid Title";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";

    var gridViewModel = new GridViewModel();
}
<style type="text/css">
    #custom-button-id {
        cursor: pointer;
        font-size: 11px;
        height: 17px;
        margin: 0 2px;
        overflow: visible;
        padding-left: 6px;
        padding-right: 6px;
        width: 18px;
        border: 0 solid red;
        background: url("/Scripts/Fanex.Grid/images/icn_add.png") 0px 0px no-repeat;
    }
</style>
<div id="sourcecontainer">
    @(Html.FanexGrid("grid-id")
        .AddColumn(new Column(gridViewModel.FirstColumnName, "First Column", 300))
        .AddColumn(new Column(gridViewModel.SecondColumnName, "Second Column", 300))
        .AddColumn(new Column(gridViewModel.ThirdColumnName, "Third Column", 300).SetCellTextAlign(TextAlign.Center).SetSortable())
        .AddColumn(new Column(gridViewModel.FourthColumnName, "Fourth Column", 300).SetSortable("desc"))
        .AddColumn(new Column(gridViewModel.FifthColumnName, "Fifth Column", 300).SetCustomCellRender("customFunctions.customCellRender"))
        .SetTitle(new TitleOption("Grid Title")
                        .SetExportExcelButton("function () { alert(\"Export Excel Button Clicked\"); }")
                        .SetBackButton("customFunctions.backFunction")
                        .SetSendMailButton("customFunctions.backFunction")
                        .SetCustomButtons("<input type=\"button\" id=\"custom-button-id\" title=\"Custom Button\">"))
        .SetNumberOfFrozenColumns(2)
        .AddBodyRows(gridViewModel.BodyRows)
    )
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
  
    </pre>
</div>
<script type="text/javascript">
    var customFunctions = {
        backFunction: function () {
            alert("Back Button Clicked");
        },
        sendMailFunction: function () {
            alert("Send Mail Function Clicked")
        }
    };

    $(function () {
        $('#custom-button-id').on('click', function () {
            alert("Custom Button Clicked");
        });
    })
</script>
