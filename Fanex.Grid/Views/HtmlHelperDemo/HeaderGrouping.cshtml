@{
    ViewBag.Title = "Header Grouping";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";

    var firstColumnName = "firstColumn";
    var secondColumnName = "secondColumn";
    var thirdColumnName = "thirdColumn";
    var fourthColumnName = "fourthColumn";
    var fifthColumnName = "fifthColumn";

    var bodyRows = new List<Row>();
    var headerRows = new List<Row>();

    for (int i = 0; i < 200; i++)
    {
        bodyRows.Add(
            new Row()
                .AddColumn(new RowColumn(firstColumnName, i))
                .AddColumn(new RowColumn(secondColumnName, i))
                .AddColumn(new RowColumn(thirdColumnName, i))
                .AddColumn(new RowColumn(fourthColumnName, i))
                .AddColumn(new RowColumn(fifthColumnName, i))
                );
    }

    headerRows.Add(
        new Row()
            .AddColumn(new RowColumn(firstColumnName).SetHeaderText("Group 1").SetMergeColumnNumber(2).SetTextAlign(TextAlign.Center))
            .AddColumn(new RowColumn(thirdColumnName).SetHeaderText("Third Column").SetMergeRowNumber(2))
            .AddColumn(new RowColumn(fourthColumnName).SetHeaderText("Fourth Column").SetMergeRowNumber(2))
            .AddColumn(new RowColumn(fifthColumnName).SetHeaderText("Fifth Column").SetMergeRowNumber(2))
            );
}

<style type="text/css">
    .freegrid .free-top-left table thead th.demo-class, .freegrid .col_header table thead th.demo-class {
        background: -webkit-linear-gradient(red, red) red;
        height: 50px !important;
    }
</style>


<div id="sourcecontainer">
    @(Html.FanexGrid("grid-id")
        .AddColumn(new Column(firstColumnName, "First Column", 300))
        .AddColumn(new Column(secondColumnName, "Second Column", 300))
        .AddColumn(new Column(thirdColumnName, "Third Column", 300).SetCellTextAlign(TextAlign.Center))
        .AddColumn(new Column(fourthColumnName, "Fourth Column", 300))
        .AddColumn(new Column(fifthColumnName, "Fifth Column", 300))
        .SetNumberOfFrozenColumns(2)
        .AddHeaderRows(headerRows)
        .AddBodyRows(bodyRows)
    )
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">

    </pre>
</div>

