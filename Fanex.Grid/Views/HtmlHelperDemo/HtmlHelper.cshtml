
@{
    ViewBag.Title = "HtmlHelper";
    Layout = "~/Views/Shared/_DemoLayout.cshtml";
    var firstColumnName = "firstColumn";
    var secondColumnName = "secondColumn";
    var thirdColumnName = "thirdColumn";
    var fourthColumnName = "fourthColumn";
    var fifthColumnName = "fifthColumn";
    
    var bodyRows = new List<Row>();
    var footerRows = new List<Row>();
    var headerRows = new List<Row>();

    for (int i = 0; i < 5000; i++)
    {
        bodyRows.Add(
            new Row()
                .AddColumn(new Cell(firstColumnName, i))
                .AddColumn(new Cell(secondColumnName, i))
                .AddColumn(new Cell(thirdColumnName, i))
                .AddColumn(new Cell(fourthColumnName, i))
                .AddColumn(new Cell(fifthColumnName, new SampleColumn { 
                    IntValue = i
                }))
                );
    }

    footerRows.Add(
            new Row()
                .AddColumn(new Cell(firstColumnName, 1).SetMergeRowNumber(2))
                .AddColumn(new Cell(secondColumnName, 2))
                .AddColumn(new Cell(thirdColumnName, 3).SetMergeColumnNumber(2))
                .AddColumn(new Cell(fifthColumnName, 5).SetMergeRowNumber(2).SetTextAlign(TextAlign.Center))
                );
    footerRows.Add(
            new Row()
                .AddColumn(new Cell(secondColumnName, 2))
                .AddColumn(new Cell(thirdColumnName, 3))
                .AddColumn(new Cell(fourthColumnName, 4))
                );  

    headerRows.Add(
        new Row()
            .AddColumn(new Cell(firstColumnName).SetHeaderText("Group 1").SetMergeColumnNumber(2).SetTextAlign(TextAlign.Center))
            .AddColumn(new Cell(thirdColumnName).SetHeaderText("Third Column").SetMergeRowNumber(2))
            .AddColumn(new Cell(fourthColumnName).SetHeaderText("Fourth Column").SetMergeRowNumber(2))
            .AddColumn(new Cell(fifthColumnName).SetHeaderText("Fifth Column").SetMergeRowNumber(2))
            );
}


@(Html.FanexGrid("grid-id")
        .AddColumn(new Column(firstColumnName, "First Column", 300))
        .AddColumn(new Column(secondColumnName, "Second Column", 300))
        .AddColumn(new Column(thirdColumnName, "Third Column", 300).SetCellTextAlign(TextAlign.Center).SetSortable())
        .AddColumn(new Column(fourthColumnName, "Fourth Column", 300).SetSortable("desc"))
        .AddColumn(new Column(fifthColumnName, "Fifth Column", 300).SetCustomCellRender("customFunctions.customCellRender"))
        .SetTitle(new TitleOption("Grid Title")
                            .SetExportExcelButton("function () { alert(\"Export Excel Button Clicked\"); }")
                            .SetBackButton("customFunctions.backFunction"))
        .SetPager(new PagerOption()
                    .SetItemsPerPage(100)
                    .SetMaxItemsPerPage(1000)
                    .SetCurrentPage(0)
                    .SetStartItemPerPage(100)
                    .SetPageStep(100))
        .SetNumberOfFrozenColumns(2)
        .AddHeaderRows(headerRows)
        .AddBodyRows(bodyRows)
        .AddFooterRows(footerRows)
    )


<script type="text/javascript">
    var customFunctions = {
        backFunction: function () {
            alert("Back Button Clicked");
        },
        customCellRender: function (cell, cellFormated) {
            return "<div style='text-align:right;'>" + cell.Value.IntValue + "a</div>";
        }
    };
</script>

