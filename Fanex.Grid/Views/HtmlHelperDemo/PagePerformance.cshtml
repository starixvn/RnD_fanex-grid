@{
    ViewBag.Title = "Custom Footer Pager";
    Layout = null;
}
<!DOCTYPE html>
<html>
<head>
    <link href="~/Scripts/Fanex.Grid/Fanex.Pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/Fanex.Grid/Fanex.Grid.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/jquery-1.8.2.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Fanex.Pagination.js" type="text/javascript"></script>
    <script src="~/Scripts/numeral.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Fanex.Grid.js?ver=2" type="text/javascript"></script>
    <script src="~/Scripts/GenerateData.js" type="text/javascript"></script>
    <script src="~/Scripts/moment.min.js" type="text/javascript"></script>
</head>
<body>
    <div id="sourcecontainer">
        <div id="filter-bar">
            <input type="button" value="Rerender" id="Rerender" />
        </div>
        <div id="gridId" class="freegrid  content-grid">
        </div>
    </div>
</body>
<script type="text/javascript">
    var footerRows = [
                  {
                      Columns: [
                        { Value: "Total", Name: "No", MergeColNumber: 2 },
                        { Value: "Footer 3", Name: "Number1" },
                        { Value: "Footer 4", Name: "Number2" },
                        { Value: "Footer 5", Name: "Number3" },
                        { Value: "Footer Merge 6", Name: "Text2", MergeColNumber: 3, CellAlign: 'center' },
                        { Value: "Footer 9", Name: "Number4" },
                        { Value: "Footer 10", Name: "Number5" }
                    ]
                  }
            ];
    var gridOptions =
        {
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "Group Header 1", Name: "No", MergeColNumber: 2 },
                                { HeaderText: "Header 3", Name: "Number1", MergeRowNumber: 2 },
                                { HeaderText: "Header 4", Name: "Number2", MergeRowNumber: 2 },
                                { HeaderText: "Group Header 2", Name: "Number3", MergeColNumber: 5 },
                                { HeaderText: "Header 10", Name: "Number5", MergeRowNumber: 2 }
                            ]
                     }
            ],
            columns: [
                { HeaderText: "Header 1", Width: 80, Name: "No", HeaderAlign: "center", CellAlign: "center", Sort: true },
                { HeaderText: "Header 2", Width: 80, Name: "Text1", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 3", Width: 100, Name: "Number1", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 4", Width: 100, Name: "Number2", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 5", Width: 160, Name: "Number3", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 6", Width: 110, Name: "Text2", Sort: true },
                { HeaderText: "Header 7", Width: 120, Name: "Text3", Sort: true },
                { HeaderText: "Header 8", Width: 150, Name: "Text4", Sort: true },
                { HeaderText: "Header 9", Width: 90, Name: "Number4", HeaderAlign: "center", CellAlign: "right", Sort: true },
                { HeaderText: "Header 10", Width: 120, Name: "Number5", HeaderAlign: "center", CellAlign: "right", Sort: true }
            ],
            bodyRows: generateData(500),
            gridExpandHeight: 150,
            numberOfFrozenColumn: 2,
            footerRows: footerRows,
            showFooter: true,
            showPager: false,
            pagerOption: {
                //                itemsPerPage: 100,
                //                maxItemsPerPage: 1000,
                //                currentPage: 0,
                //                totalItem: 100,
                //                startPerPage: 100,
                //                pageStep:         
                itemsPerPage: 100,
                currentPage: 0,
                itemsPerPageArray: [50, 100, 500],
                showDetail: true,
                customRenderFooter: function (bodyRows, pageIndex, itemsPerPage) {
                    footerRows[0].Columns[0].Value += 1;
                    return footerRows;
                }
            }
        };
    $(function () {
        var currentGrid = $("#gridId").fanexGrid(gridOptions);
        $('#Rerender').click(function () {
            var columns = $("#gridId").fanexGrid(gridOptions);
        }
        );
    });
</script>
</html>
