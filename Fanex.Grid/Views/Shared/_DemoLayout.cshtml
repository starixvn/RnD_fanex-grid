<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <link href="~/Styles/normalize.css" rel="stylesheet" type="text/css" />
    <link href="~/Styles/style.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/Fanex.Grid/Fanex.Pagination.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/Fanex.Grid/Fanex.Grid.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.en-US.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.ja-JP.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.ko-KR.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.zh-TW.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.th-TH.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.vi-VN.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Language/Fanex.Gird.Lang.zh-CN.js" type="text/javascript"></script>
    @*<link href="~/Scripts/Fanex.Grid/Fanex.Grid.less" rel="stylesheet" type="text/css" />*@
    <link href="~/Styles/theme.css" rel="stylesheet" type="text/css" />
    <script src="~/Scripts/jquery-1.8.2.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Fanex.Pagination.js" type="text/javascript"></script>
    <script src="~/Scripts/numeral.js" type="text/javascript"></script>
    <script src="~/Scripts/Fanex.Grid/Fanex.Grid.js?ver=2" type="text/javascript"></script>
    <script src="~/Scripts/GenerateData.js" type="text/javascript"></script>
    <script src="~/Scripts/moment.min.js" type="text/javascript"></script>
    @*HighlightSyntax*@
    <link href="~/Scripts/HighLightSyntax/styles/shCore.css" rel="stylesheet" type="text/css" />
    <link href="~/Scripts/HighLightSyntax/styles/shThemeDefault.css" rel="stylesheet"
        type="text/css" />
    <script src="~/Scripts/HighLightSyntax/scripts/XRegExp.js" type="text/javascript"></script>
    <script src="~/Scripts/HighLightSyntax/scripts/shCore.js" type="text/javascript"></script>
    <script src="~/Scripts/HighLightSyntax/scripts/shLegacy.js" type="text/javascript"></script>
    <script src="~/Scripts/HighLightSyntax/scripts/shBrushGroovy.js" type="text/javascript"></script>

    <title>@ViewBag.Title</title>
</head>
<body>
    <div id="header">
        Fanex Grid Document
    </div>
    <div id="body-content">
        <div id="left-panel">
            <div class="header-text">
                Documents and Examples
            </div>
            <ul>
                <li class="demo-link"><span class="doc-icon"></span><a href="@Url.Action("Index", "Demo")">
                    Overview</a></li>
                <li class="demo-link"><span class="doc-icon"></span><a href="@Url.Action("Api", "Demo")">
                    Api</a></li>
                <li class="demo-link"><span class="doc-icon"></span><a href="@Url.Content("~/Fanex.Grid.zip")">
                    Download Fanex.Grid</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("DefaultFunctionality", "Demo")">Default Option</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("HeaderGrouping", "Demo")">Header Grouping</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("GridTitle", "Demo")">Grid Title</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Footer", "Demo")">Footer</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Sorting", "Demo")">Sorting</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("CustomSorting", "Demo")">Custom Sorting</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Pager", "Demo")">Pager</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("CustomPager", "Demo")">Custom Pager</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("FrozenColumns", "Demo")">Frozen Columns</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("ShowHideColumns", "Demo")">Show/Hide Columns</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("FormatNumber", "Demo")">Format Number</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Merging", "Demo")">Merging</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("CustomCell", "Demo")">Custom Cell</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("CustomOption", "Demo")">Custom Grid Option</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("TreeGrid", "Demo")">Tree Grid</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("AutoTruncate", "Demo")">Auto Truncate</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Demo5000Rows", "Demo")">5000 Rows</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("AppendBodyRows", "Demo")">Append Body Rows</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("MultipleLanguage", "Demo")">Multiple Language</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("AutoResizeColumns", "Demo")">Auto Resize Columns</a></li>
                <li class="demo-link"><span class="example-icon"></span><a href="@Url.Action("Demo1000Rows100Cols", "Demo")">1000 Rows 100 Cols</a></li>
            </ul>
        </div>
        <div id="main-panel">
            <div class="header-text">
                @ViewBag.Title
            </div>
            @{
                if (ViewBag.IsShowDemo == null || ViewBag.IsNotShowDemo == false)
                {
                <div class="menu">
                    <ul>
                        <li><a href="#" id="viewdemo">View Demo </a></li>
                        <li><a href="#">|| </a></li>
                        <li><a href="#" id="viewsource">View Source </a></li>
                    </ul>
                </div>
                }
            }
            @RenderBody()
        </div>
    </div>
</body>
<script type="text/javascript">
    $(function () {
        $('#viewdemo').click(function () {
            $('#viewsourcecontainer').hide();
            $('#sourcecontainer').show();
            return false;
        });
        $('#viewsource').click(function () {
            $('#viewsourcecontainer').show();
            $('#sourcecontainer').hide();
            return false;
        });

        dp.SyntaxHighlighter.HighlightAll('code');
    });
</script>
</html>
