@{
    ViewBag.Title = "DemoGrid";
    Layout = "~/Views/Shared/_MainLayout.cshtml";
}
<div id="sourcecontainer">
    <div id="gridId" class="freegrid  content-grid">
    </div>
    <div>
        <input type="button" value="Re-Render" id="btnReRender" />
         <input type="button" value="Resize" id="btnResize" />
         <input type="button" value="FullSize" id="btnFullSize" />
    </div>
</div>
<div id="viewsourcecontainer" style="height: 760px; overflow: auto; display: none;">
    <pre name="code" class="groovy">
        //// Html
         <div id="gridId" class="freegrid">
        </div>
        //// Script
           var gridOptions =
        {
            columns: [
                { HeaderText: "CHeader1", Width: 100, Name: "Data1", Sort: true, TdClass: "tdclasssample" },
                { HeaderText: "CHeader2", Width: 100, Name: "Data2", CssClass: "demoHeaderClass" },
                { HeaderText: "CHeader3", Width: 100, Name: "Data3",
                    CustomHeaderRender: function (col) {
                        return "<div style='width:100px;'>" + col.HeaderText + " Demo" + "</div>";
                    }, AllowTruncate: true
                },
                { HeaderText: "Ceader4", Width: 100, Name: "Data4", CellAlign: "center", CanShowHide: true },
                { HeaderText: "Colader5", Width: 100, Name: "Data5", Sort: true, HeaderAlign: "center", CellAlign: "right" },
                { HeaderText: "Coder12", Width: 100, Name: "Data12" }
            ],
            customizeHeader: true,
            groupHeaderRows: [
                     {
                         Columns: [
                                { HeaderText: "CHeader1", Name: "Data1", MergeRowNumber: 2 },
                                { HeaderText: "Ceader6", Name: "Data2", MergeRowNumber: 2 },
                                { HeaderText: "Colader7", Name: "Data3", MergeColNumber: 4 }
                            ]
                     }
            ],
            bodyRows: CreateBody(10),
            numberOfFrozenColumn: 1,
            showFooter: false,
            footerRows: [
                  {
                      Columns: [
                        { Name: "Data1", Value: "Total", MergeRowNumber: 2, CssClass: "demoFooterClass", CellAlign: 'center' },
                        { Name: "Data2", Value: 1530, CustomCellRender: function (item) {
                            return "<div style='text-align:right;'>" + item.Value + "demo" + "</div>";
                        }
                        },
                        { Name: "Data3", Value: 130 },
                        { Name: "Data4", Value: 1520 },
                        { Name: "Data5", Value: 1350 },
                        { Name: "Data12", Value: 1350, MergeRowNumber: 2 }
                    ]
                  },
                  {
                      Columns: [
                        { Name: "Data2", Value: 1530 },
                        { Name: "Data3", Value: 1630 },
                        { Name: "Data4", Value: 1520 },
                        { Name: "Data5", Value: 1350 }
                    ]
                  }
            ],
            showTitle: true,
            titleInfo:
                {
                    text: "Demo Title",
                    showExcelButton: true,
                    exportExcelFunction: function () {
                        alert("Export Excel Button Clicked");
                    },
                    showBackButton: true,
                    backFunction: function () {
                        alert("Back Button Clicked");
                    },
                    showSendMailButton: true,
                    sendMailFunction: function () {
                        alert("Send Mail Button Clicked");
                    }
                },
            showPager: true,
            pagerOption: {
                itemsPerPage: 10,
                maxItemsPerPage: 100,
                currentPage: 0,
                totalItem: 1000,
                startPerPage: 10,
                pageStep: 10,
                pagerSelectCallBack: function (page_index, itemsPerPage, jq) {
                    alert("pageIndex:" + page_index + ", itemPerPage:" + itemsPerPage + ", jq:" + jq);
                }
            },
            customPager: false,
            sortFunction: function (columnName, sortDirection) {
                alert("Col: " + columnName + ", " + sortDirection);
            },
            gridExpandHeight: 120,
            showColumnsShowHide: true,
            showDistinctRow: true,
            highlightFrozenWidth: 2,
            marginRight: 5,
            allowTruncate: true
        };
        $(function () {
            var currentGrid = $("#gridId").fanexGrid(gridOptions);
            });
    </pre>
</div>
